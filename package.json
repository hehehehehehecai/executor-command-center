{
  "name": "executor-command-center",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:check": "vitest run src/shared/configuration/environment-validation.ci.test.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:lint": "supabase db lint --local --level error --fail-on error",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "db:drift:check": "node scripts/check-database-drift.mjs",
    "test:integration:app": "vitest run --config vitest.integration.config.ts",
    "test:integration:db": "supabase test db --local",
    "test:integration": "pnpm run test:integration:app && pnpm run test:integration:db",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:auth-fixture": "node scripts/run-auth-fixture-e2e.mjs",
    "test:e2e:installation-fixture": "node scripts/run-installation-fixture-e2e.mjs",
    "test:e2e:repository-fixture": "node scripts/run-repository-fixture-e2e.mjs",
    "test:e2e:repository-selection-fixture": "node scripts/run-repository-selection-fixture-e2e.mjs",
    "test:e2e:preview": "node scripts/run-preview-e2e.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
